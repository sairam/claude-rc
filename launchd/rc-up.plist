<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by `rc autostart on`: runs `rc up` once at login (starts pinned repos). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-lc</string><string>sleep 20; "__RC__" up</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>HOME</key><string>__HOME__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__LOG__</string>
  <key>StandardErrorPath</key><string>__LOG__</string>
</dict>
</plist>
